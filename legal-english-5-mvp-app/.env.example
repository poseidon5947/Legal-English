# "alpha" = local JSON store + in-app mock inbox, no external services required.
# "production" = Supabase Auth + Postgres/RLS. Requires the vars below and the
# migrations in supabase/migrations applied to a real Supabase project.
NEXT_PUBLIC_DATA_MODE=alpha
LE5_SESSION_SECRET=replace-in-production
# Alpha only: where alpha-store.json, avatars/ and insights.json are written.
# Defaults to ./data when writable, otherwise the OS temp dir (read-only hosts
# such as Vercel, where alpha state resets on every cold start).
LE5_DATA_DIR=

# Supabase (required when NEXT_PUBLIC_DATA_MODE=production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for admin user management
# (auth.admin.deleteUser) and subscription/entitlement writes from the
# Mercado Pago webhook, which authenticated users must not be able to write.
SUPABASE_SERVICE_ROLE_KEY=

# Payments: "simulator" keeps the in-app billing buttons (alpha demo only).
# "mercadopago" enables app/api/webhooks/mercadopago (signature-verified) and
# routes every state change through it instead of trusting the client.
# Register https://<domain>/api/webhooks/mercadopago for "Plans and
# Subscriptions" events in the Owner's Mercado Pago application.
PAYMENT_PROVIDER=simulator
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PLAN_MONTHLY_ID=
MERCADOPAGO_PLAN_ANNUAL_ID=

# Resend is not called directly by app code: configure it as the custom SMTP
# provider in Supabase Auth (Dashboard -> Authentication -> Emails -> SMTP
# Settings) so verification/recovery emails send through Resend. Keep the key
# here only if a future server action needs to send mail outside Supabase Auth.
RESEND_API_KEY=

# Public origin used for canonical URLs, sitemap.xml, robots.txt and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
